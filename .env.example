# Shared runtime configuration
PORT=3000
NODE_ENV=development

# Supabase project shared by the team. Server-side only: never expose this key
# in a browser, frontend build, commit, or log.
SUPABASE_URL=https://gnfclypudmazqatimyos.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<obtain-from-the-team-password-manager>

# Safe for a future browser dashboard. This key can be committed to a frontend
# build, unlike SUPABASE_SECRET_KEY.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<copy-from-supabase-api-keys>

# Required by the current Realtime voice spike.
OPENAI_API_KEY=sk-<obtain-from-the-team-password-manager>

# Identities used by `npm run db:seed`. Replace these E.164 placeholders with
