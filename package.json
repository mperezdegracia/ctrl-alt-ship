{
  "name": "ctrl-alt-ship",
  "version": "1.0.0",
  "description": "Workspace launcher for the Ctrl Alt Ship applications.",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:backend": "npm run dev --workspace @ctrl-alt-ship/backend",
    "start": "npm run start:backend",
    "start:backend": "npm run start --workspace @ctrl-alt-ship/backend",
    "db:smoke": "npm run db:smoke --workspace @ctrl-alt-ship/backend",
    "db:seed": "npm run db:seed --workspace @ctrl-alt-ship/backend",
    "auth:smoke": "npm run auth:smoke --workspace @ctrl-alt-ship/backend",
    "typecheck": "npm run typecheck --workspace @ctrl-alt-ship/backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mperezdegracia/ctrl-alt-ship.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mperezdegracia/ctrl-alt-ship/issues"
  },
  "homepage": "https://github.com/mperezdegracia/ctrl-alt-ship#readme"
}
