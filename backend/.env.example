# Backend runtime
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
# Enable only after applying 20260830010000_client_operation_tools.sql.
CLIENT_OPERATION_TOOLS_ENABLED=false
# Consecutive caller turns without a completed business tool before server escalation.
ESCALATION_STALLED_TURNS=3
TWILIO_ACCOUNT_SID=AC<copy-from-twilio>
TWILIO_AUTH_TOKEN=<copy-from-twilio>
TWILIO_FROM_NUMBER=+14155550100
SUPERVISOR_PHONE=+5491100000000
PUBLIC_BASE_URL=https://ctrl-alt-ship.onrender.com

# Shared Supabase project. These are server-only values.
SUPABASE_URL=https://gnfclypudmazqatimyos.supabase.co
SUPABASE_SECRET_KEY=sb_secret_<obtain-from-the-team-password-manager>

# Used only to validate user JWTs. It is safe for the frontend too.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<copy-from-supabase-api-keys>

# Comma-separated browser origins allowed to call Render directly.
DASHBOARD_ORIGINS=http://localhost:3001

# Required by the current Realtime voice spike.
OPENAI_API_KEY=sk-<obtain-from-the-team-password-manager>
OPENAI_PROJECT_ID=proj_<copy-from-the-openai-project-settings>
# Create this in OpenAI Project Settings > Webhooks. Never expose it.
OPENAI_WEBHOOK_SECRET=whsec_<copy-from-the-openai-webhook>

# Required only for outbound calls. Keep this server-only.
OUTBOUND_CALLS_TOKEN=<generate-a-random-32-character-minimum-secret>

# Identities used by `npm run db:seed`. Replace these E.164 placeholders with
# consented test numbers. Every caller ID must be unique across both contacts
# and providers.
SEED_CLIENT_PHONE=+5491163723502
SEED_CLIENT_EMAIL=lucasaffre@gmail.com
SEED_PROVIDER_1_NAME=Theo
SEED_PROVIDER_1_PHONE=+5491132555829
SEED_PROVIDER_1_EMAIL=operaciones@transportesur.example.com
SEED_PROVIDER_2_NAME=Mateo
SEED_PROVIDER_2_PHONE=+5491151365124
SEED_PROVIDER_2_EMAIL=trafico@logisticaruta3.example.com
SEED_PROVIDER_3_NAME=Paki
SEED_PROVIDER_3_PHONE=+5491163718087
SEED_PROVIDER_3_EMAIL=despacho@fletesdelplata.example.com

# Optional: set immediately before the trial-by-fire run. If empty, no judge
# provider is created.
SEED_JUDGE_PHONE=
SEED_JUDGE_NAME=Trial by Fire Judge
SEED_JUDGE_EMAIL=judge@example.com

# Stable reference makes the complete Textiles del Plata fixture idempotent.
SEED_OPERATION_REFERENCE=OP-900001
