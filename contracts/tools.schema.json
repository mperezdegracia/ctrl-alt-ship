{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tango agent tool contracts",
  "version": "1.0.0",
  "context_policy": {
    "description": "Internal IDs and authorization context are resolved by the server from the live call. They are never accepted as model-controlled arguments.",
    "server_injected": [
      "call_id",
      "contact_id",
      "provider_id",
      "operation_id",
      "mandate_id",
      "quote_request_id",
      "booking_id",
      "transcript_excerpt",
      "recording_checkpoint"
    ]
  },
  "profiles": {
    "client_entry": [
      "list_open_operations",
      "create_operation",
      "update_operation",
      "cancel_operation"
    ],
    "client_create": ["update_operation", "confirm_mandate"],
    "client_update": ["update_operation", "confirm_mandate"],
    "client_confirm": ["update_operation", "confirm_mandate"],
    "provider_inbound_entry": [
      "list_provider_operations",
      "create_quote",
      "decline_quote_request",
      "confirm_booking",
      "decline_booking",
      "reschedule_booking",
      "cancel_booking",
      "escalate"
    ],
    "provider_outbound_quote": [
      "create_quote",
      "decline_quote_request",
      "escalate"
    ],
    "provider_outbound_booking": [
      "confirm_booking",
      "decline_booking",
      "escalate"
    ],
    "provider_outbound_reschedule": [
      "reschedule_booking",
      "decline_reschedule",
      "escalate"
    ],
    "terminal": []
  },
  "tools": [
    {
      "type": "function",
      "name": "list_open_operations",
      "description": "Lists only the authenticated client's open operations so the caller can identify one before updating or cancelling it.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
                "operation_name": { "type": "string", "minLength": 1, "description": "Display name derived from pickup and delivery locations; not a unique identifier." },
                "status": { "type": "string" },
                "container_type": { "type": ["string", "null"] },
                "pickup_location": { "type": ["string", "null"] },
                "delivery_location": { "type": ["string", "null"] },
                "updated_at": { "type": "string", "format": "date-time" }
              },
              "required": [
                "operation_reference",
                "operation_name",
                "status",
                "container_type",
                "pickup_location",
                "delivery_location",
                "updated_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["operations"],
        "additionalProperties": false
      },
      "x-personas": ["client"],
      "x-mutating": false
    },
    {
      "type": "function",
      "name": "create_operation",
      "description": "Creates a new draft operation for the authenticated client using only facts already stated in the conversation. Missing fields remain null and must never be invented.",
      "parameters": {
        "type": "object",
        "properties": {
          "container_type": { "type": "string", "minLength": 1 },
          "gross_weight_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 999999999.999, "multipleOf": 0.001 },
          "pickup_location": { "type": "string", "minLength": 1 },
          "delivery_location": { "type": "string", "minLength": 1 },
          "empty_return_depot": { "type": "string", "minLength": 1 },
          "operational_constraints": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "cargo_notes": { "type": "string", "minLength": 1 }
        },
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "status": { "const": "collecting_details" },
          "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "next_profile": { "type": "string", "enum": ["client_create", "client_confirm"] }
        },
        "required": ["operation_reference", "status", "missing_fields", "next_profile"],
        "additionalProperties": false
      },
      "x-personas": ["client"],
      "x-mutating": true,
      "x-locks-intent": "create"
    },
    {
      "type": "function",
      "name": "update_operation",
      "description": "Updates the selected operation with facts explicitly provided by the authenticated client. At client entry, operation_reference selects and locks the operation; after selection it may be omitted.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "changes": {
            "type": "object",
            "properties": {
              "container_type": { "type": "string", "minLength": 1 },
              "gross_weight_kg": { "type": "number", "exclusiveMinimum": 0, "maximum": 999999999.999, "multipleOf": 0.001 },
              "pickup_location": { "type": "string", "minLength": 1 },
              "delivery_location": { "type": "string", "minLength": 1 },
              "empty_return_depot": { "type": "string", "minLength": 1 },
              "operational_constraints": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "cargo_notes": { "type": ["string", "null"] }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "required": ["changes"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "status": { "type": "string" },
          "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "mandate_confirmation_required": { "type": "boolean" },
          "next_profile": {
            "type": "string",
            "enum": ["client_create", "client_update", "client_confirm"]
          }
        },
        "required": [
          "operation_reference",
          "status",
          "missing_fields",
          "mandate_confirmation_required",
          "next_profile"
        ],
        "additionalProperties": false
      },
      "x-personas": ["client"],
      "x-mutating": true,
      "x-locks-intent": "update"
    },
    {
      "type": "function",
      "name": "cancel_operation",
      "description": "Cancels an operation only after the authenticated client explicitly confirms the cancellation. This is a terminal logical cancellation, never a database delete.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["operation_reference", "reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "status": { "const": "cancelled" },
          "provider_email_queued": { "type": "boolean" },
          "next_profile": { "const": "terminal" }
        },
        "required": ["operation_reference", "status", "provider_email_queued", "next_profile"],
        "additionalProperties": false
      },
      "x-personas": ["client"],
      "x-mutating": true,
      "x-locks-intent": "cancel"
    },
    {
      "type": "function",
      "name": "confirm_mandate",
      "description": "Creates an immutable mandate after verbal confirmation. First mandate: provide all commercial terms and confirm the full summary. Updating an existing mandate: confirm only the changes and send only changed commercial terms (or {}); the server inherits omitted terms from the current mandate and builds the full snapshot.",
      "parameters": {
        "type": "object",
        "properties": {
          "price_cap": { "type": "number", "exclusiveMinimum": 0, "maximum": 999999999999.99, "multipleOf": 0.01 },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "action_windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "start_at": { "type": "string", "format": "date-time" },
                "end_at": { "type": "string", "format": "date-time" }
              },
              "required": ["start_at", "end_at"],
              "additionalProperties": false
            }
          },
          "minimum_payment_term_days": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
        },
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "mandate_version": { "type": "integer", "minimum": 1 },
          "status": { "const": "sourcing" },
          "next_profile": { "const": "terminal" }
        },
        "required": ["operation_reference", "mandate_version", "status", "next_profile"],
        "additionalProperties": false
      },
      "x-personas": ["client"],
      "x-mutating": true
    },
    {
      "type": "function",
      "name": "list_provider_operations",
      "description": "Lists only operations where the authenticated provider has an active quote request or booking, for inbound intent selection.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
                "operation_name": { "type": "string", "minLength": 1, "description": "Display name derived from pickup and delivery locations; not a unique identifier." },
                "relationship": {
                  "type": "string",
                  "enum": ["quote_requested", "booking_pending", "booking_confirmed"]
                },
                "pickup_location": { "type": "string" },
                "delivery_location": { "type": "string" },
                "container_type": { "type": "string" }
              },
              "required": [
                "operation_reference",
                "operation_name",
                "relationship",
                "pickup_location",
                "delivery_location",
                "container_type"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["operations"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": false
    },
    {
      "type": "function",
      "name": "create_quote",
      "description": "Records a complete provider quote as an immutable version. The server evaluates it against the current mandate and never returns the client's price cap.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "price_range": {
            "type": "object",
            "properties": {
              "min": { "type": "number", "exclusiveMinimum": 0 },
              "max": { "type": "number", "exclusiveMinimum": 0 },
              "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
            },
            "required": ["min", "max", "currency"],
            "additionalProperties": false
          },
          "proposed_pickup_window": {
            "type": "object",
            "properties": {
              "start_at": { "type": "string", "format": "date-time" },
              "end_at": { "type": "string", "format": "date-time" }
            },
            "required": ["start_at", "end_at"],
            "additionalProperties": false
          },
          "payment_term_days": { "type": "integer", "minimum": 0 },
          "valid_until": { "type": "string", "format": "date-time" },
          "conditions": {
            "type": "object",
            "properties": {
              "notes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              }
            },
            "required": ["notes"],
            "additionalProperties": false
          }
        },
        "required": [
          "price_range",
          "proposed_pickup_window",
          "payment_term_days",
          "valid_until",
          "conditions"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "quote_version": { "type": "integer", "minimum": 1 },
          "verdict": { "type": "string", "enum": ["dentro", "contraoferta", "fuera"] },
          "reason_codes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "negotiation_remaining": { "type": "boolean" }
        },
        "required": [
          "operation_reference",
          "quote_version",
          "verdict",
          "reason_codes",
          "negotiation_remaining"
        ],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "quote"
    },
    {
      "type": "function",
      "name": "decline_quote_request",
      "description": "Records that the provider explicitly declined to quote. It creates no quote or commitment.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "reason": {
            "type": "string",
            "enum": [
              "no_capacity",
              "unavailable_window",
              "price_terms",
              "route_unsupported",
              "operational_constraints",
              "other"
            ]
          },
          "details": { "type": "string", "minLength": 1 }
        },
        "required": ["reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "const": "declined" },
          "commitment_created": { "const": false }
        },
        "required": ["status", "commitment_created"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "quote"
    },
    {
      "type": "function",
      "name": "confirm_booking",
      "description": "Confirms the selected booking only after the provider explicitly accepts the exact terms. The final price must remain within the selected quote range and current mandate.",
      "parameters": {
        "type": "object",
        "properties": {
          "confirmed_price": { "type": "number", "exclusiveMinimum": 0 },
          "provider_confirmation_reference": { "type": "string", "minLength": 1 }
        },
        "required": ["confirmed_price"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "status": { "const": "booking_confirmed" },
          "confirmed_price": { "type": "number", "exclusiveMinimum": 0 },
          "commitment_created": { "const": true }
        },
        "required": ["operation_reference", "status", "confirmed_price", "commitment_created"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "booking_confirmation"
    },
    {
      "type": "function",
      "name": "decline_booking",
      "description": "Records the provider's explicit refusal of a pending booking and returns the operation to selection or sourcing.",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "no_capacity",
              "unavailable_window",
              "price_terms",
              "route_unsupported",
              "operational_constraints",
              "other"
            ]
          },
          "details": { "type": "string", "minLength": 1 }
        },
        "required": ["reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "const": "declined" },
          "commitment_created": { "const": false },
          "operation_status": { "type": "string", "enum": ["quote_selected", "sourcing", "needs_follow_up"] }
        },
        "required": ["status", "commitment_created", "operation_status"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "booking_confirmation"
    },
    {
      "type": "function",
      "name": "reschedule_booking",
      "description": "Changes only the pickup window while preserving the confirmed price and terms. Outside the action window it applies nothing and requires escalation.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "proposed_pickup_window": {
            "type": "object",
            "properties": {
              "start_at": { "type": "string", "format": "date-time" },
              "end_at": { "type": "string", "format": "date-time" }
            },
            "required": ["start_at", "end_at"],
            "additionalProperties": false
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["proposed_pickup_window", "reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["applied", "requires_escalation"] },
          "reason_code": { "type": ["string", "null"] },
          "commitment_created": { "type": "boolean" }
        },
        "required": ["status", "reason_code", "commitment_created"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "reschedule"
    },
    {
      "type": "function",
      "name": "decline_reschedule",
      "description": "Records the provider's refusal of a proposed reschedule. The previous booking and commitment remain active.",
      "parameters": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "no_capacity",
              "unavailable_window",
              "price_terms",
              "route_unsupported",
              "operational_constraints",
              "other"
            ]
          },
          "details": { "type": "string", "minLength": 1 }
        },
        "required": ["reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "const": "rejected" },
          "previous_commitment_active": { "const": true }
        },
        "required": ["status", "previous_commitment_active"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "reschedule"
    },
    {
      "type": "function",
      "name": "cancel_booking",
      "description": "Cancels the authenticated provider's active booking after explicit verbal confirmation, preserves the audit trail, and returns the operation to sourcing.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "booking_status": { "const": "cancelled" },
          "operation_status": { "const": "sourcing" },
          "commitment_created": { "const": true },
          "client_email_queued": { "type": "boolean" }
        },
        "required": ["booking_status", "operation_status", "commitment_created", "client_email_queued"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "cancel_booking"
    },
    {
      "type": "function",
      "name": "escalate",
      "description": "Starts a live supervisor handoff for a provider conversation. It sends commitments, mandate and reason out of band, never the raw transcript or price cap.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": { "type": "string", "pattern": "^OP-[0-9]{6,}$" },
          "trigger": {
            "type": "string",
            "enum": [
              "explicit_human_request",
              "outside_mandate",
              "negotiation_stalled",
              "identity_concern",
              "other"
            ]
          },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["trigger", "reason"],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["started", "failed"] },
          "supervisor_notified": { "type": "boolean" }
        },
        "required": ["status", "supervisor_notified"],
        "additionalProperties": false
      },
      "x-personas": ["provider"],
      "x-mutating": true,
      "x-locks-intent": "escalation"
    }
  ]
}
