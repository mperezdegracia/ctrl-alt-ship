{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tango agent tool contracts",
  "version": "2.0.0",
  "context_policy": {
    "description": "Internal IDs and authorization context are resolved by the server from the live call. They are never accepted as model-controlled arguments.",
    "server_injected": [
      "call_id",
      "contact_id",
      "provider_id",
      "operation_id",
      "mandate_id",
      "quote_request_id",
      "booking_id",
      "direction",
      "purpose",
      "round_id",
      "current_booking_id",
      "source_call_id",
      "evidence_start_segment_id",
      "evidence_end_segment_id"
    ]
  },
  "profiles": {
    "client_entry": [
      "list_open_operations",
      "create_operation",
      "update_operation",
      "cancel_operation"
    ],
    "client_create": [
      "update_operation",
      "confirm_mandate"
    ],
    "client_update": [
      "update_operation",
      "confirm_mandate"
    ],
    "client_confirm": [
      "update_operation",
      "confirm_mandate"
    ],
    "terminal": [],
    "provider_inbound_entry": [
      "list_provider_operations",
      "select_booking_for_reschedule",
      "select_booking_for_cancellation"
    ],
    "provider_reschedule": [
      "reschedule_booking",
      "escalate"
    ],
    "provider_cancel_booking": [
      "cancel_booking",
      "escalate"
    ],
    "provider_booking_escalation": [
      "escalate"
    ],
    "provider_quote": [
      "record_provider_offer",
      "create_quote",
      "decline_quote_request",
      "escalate"
    ],
    "provider_unavailable": []
  },
  "tools": [
    {
      "type": "function",
      "name": "list_open_operations",
      "description": "Lists only the authenticated client's open operations so the caller can identify one before updating or cancelling it.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation_reference": {
                  "type": "string",
                  "pattern": "^OP-[0-9]{6,}$"
                },
                "operation_name": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Display name derived from pickup and delivery locations; not a unique identifier."
                },
                "status": {
                  "type": "string"
                },
                "container_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pickup_location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delivery_location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "operation_reference",
                "operation_name",
                "status",
                "container_type",
                "pickup_location",
                "delivery_location",
                "updated_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "client"
      ],
      "x-mutating": false
    },
    {
      "type": "function",
      "name": "create_operation",
      "description": "Creates a new draft operation for the authenticated client using only facts already stated in the conversation. Missing fields remain null and must never be invented.",
      "parameters": {
        "type": "object",
        "properties": {
          "pickup_location": {
            "type": "string",
            "minLength": 1
          },
          "delivery_location": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "status": {
            "const": "collecting_details"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "next_profile": {
            "type": "string",
            "enum": [
              "client_create",
              "client_confirm"
            ]
          }
        },
        "required": [
          "operation_reference",
          "status",
          "missing_fields",
          "next_profile"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "client"
      ],
      "x-mutating": true,
      "x-locks-intent": "create"
    },
    {
      "type": "function",
      "name": "update_operation",
      "description": "Updates the selected operation with facts explicitly provided by the authenticated client. At client entry, operation_reference selects and locks the operation; after selection it may be omitted.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "changes": {
            "type": "object",
            "properties": {
              "pickup_location": {
                "type": "string",
                "minLength": 1
              },
              "delivery_location": {
                "type": "string",
                "minLength": 1
              }
            },
            "minProperties": 1,
            "additionalProperties": false
          }
        },
        "required": [
          "changes"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "status": {
            "type": "string"
          },
          "missing_fields": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "mandate_confirmation_required": {
            "type": "boolean"
          },
          "next_profile": {
            "type": "string",
            "enum": [
              "client_create",
              "client_update",
              "client_confirm"
            ]
          }
        },
        "required": [
          "operation_reference",
          "status",
          "missing_fields",
          "mandate_confirmation_required",
          "next_profile"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "client"
      ],
      "x-mutating": true,
      "x-locks-intent": "update"
    },
    {
      "type": "function",
      "name": "cancel_operation",
      "description": "Cancels an operation only after the authenticated client explicitly confirms the cancellation. This is a terminal logical cancellation, never a database delete. No email is sent or queued.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "operation_reference",
          "reason"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "status": {
            "const": "cancelled"
          },
          "provider_email_queued": {
            "type": "boolean"
          },
          "next_profile": {
            "const": "terminal"
          }
        },
        "required": [
          "operation_reference",
          "status",
          "provider_email_queued",
          "next_profile"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "client"
      ],
      "x-mutating": true,
      "x-locks-intent": "cancel"
    },
    {
      "type": "function",
      "name": "confirm_mandate",
      "description": "Confirms the order and mandate after ONE combined verbal approval. First mandate: save origin/destination first, then provide price_cap, currency and action_windows. Updates inherit omitted terms; send only changes (or {}). Never ask for separate order, mandate and sourcing approvals.",
      "parameters": {
        "type": "object",
        "properties": {
          "price_cap": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 999999999999.99,
            "multipleOf": 0.01
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "action_windows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "start_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "end_at": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "start_at",
                "end_at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "mandate_version": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "const": "sourcing"
          },
          "next_profile": {
            "const": "terminal"
          }
        },
        "required": [
          "operation_reference",
          "mandate_version",
          "status",
          "next_profile"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "client"
      ],
      "x-mutating": true
    },
    {
      "type": "function",
      "name": "list_provider_operations",
      "description": "Lists only the authenticated provider's current bookings selected by operations.current_booking_id.",
      "parameters": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "operation_reference": {
                  "type": "string",
                  "pattern": "^OP-[0-9]{6,}$"
                },
                "pickup_location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "delivery_location": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pickup_window": {
                  "type": "object",
                  "properties": {
                    "start_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "end_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "start_at",
                    "end_at"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "operation_reference",
                "pickup_location",
                "delivery_location",
                "pickup_window"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "operations"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "provider"
      ],
      "x-mutating": false
    },
    {
      "type": "function",
      "name": "create_quote",
      "description": "Records only the provider's price for the verified job after one brief verbal approval. For a fixed amount use equal min/max. Currency and pickup come from verified context; do not ask for or send payment, expiry or conditions. Counteroffers change only price. The server evaluates against the private mandate.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "price_range": {
            "type": "object",
            "properties": {
              "min": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "min",
              "max"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "price_range"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "quote_version": {
            "type": "integer",
            "minimum": 1
          },
          "verdict": {
            "type": "string",
            "enum": [
              "dentro",
              "contraoferta",
              "fuera"
            ]
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "negotiation_remaining": {
            "type": "boolean"
          },
          "negotiation_rounds_remaining": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "operation_reference",
          "quote_version",
          "verdict",
          "reason_codes",
          "negotiation_remaining",
          "negotiation_rounds_remaining"
        ],
        "additionalProperties": false
      },
      "x-personas": [
        "provider"
      ],
      "x-mutating": true,
      "x-locks-intent": "quote"
    },
    {
      "type": "function",
      "name": "decline_quote_request",
      "description": "Records that the provider explicitly declined to quote. It creates no quote or booking.",
      "parameters": {
        "type": "object",
        "properties": {
          "operation_reference": {
            "type": "string",
            "pattern": "^OP-[0-9]{6,}$"
          },
          "reason": {
            "type": "string",
