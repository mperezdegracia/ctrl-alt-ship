        },
        "required": [
          "reason"
        ],
        "additionalProperties": false
      },
      "returns": {
        "type": "object",
        "properties": {
          "status": {
            "const": "declined"
          },
          "commitment_created": {
            "const": false,
            "deprecated": true,
            "description": "Legacy compatibility field; there is no Commitment entity."
          }
